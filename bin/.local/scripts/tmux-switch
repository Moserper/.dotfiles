#!/usr/bin/env bash
# tmux-switch — fuzzy-jump to any live tmux window/session (fleet switcher).
# Pure tmux + fzf, no external state; previews the target's active-pane screen,
# switches the client to the chosen one.
# Bound in tmux.conf:  bind j display-popup -E "~/.local/scripts/tmux-switch"
#
# TWO VIEW MODES, cycled with tab (state lives in the fzf prompt, e.g.
# "switch [session] ❯", read back via $FZF_PROMPT in the transform binding):
#   session       one row per session   SESSION attached? APP AGE Nwin   (default)
#   win:<session> one row per window of THAT session   WHERE WINDOW-NAME APP AGE
# Tab drills DOWN: from session view it opens the highlighted session's windows
# (scope = "[win:<sess>]" in the prompt); Tab again pops back to session view.
# The hidden field-1 of every row is a representative ACTIVE pane id — so the final
# select-window/select-pane/switch-client path lands exactly there, and ctrl-x can
# `kill-window -t {1}` (a pane id resolves to its window) or `kill-session -t {1}`
# (the same pane id also resolves to its session — verified).
#   tab    : drill into highlighted session <-> back to session list
#            (scope is parsed back out of the prompt; the highlighted session is
#             resolved from {1} via tmux display-message, like ctrl-o)
#   ctrl-x : kill the highlighted target, then reload — WINDOW in win view,
#            whole SESSION in session view (branches on the mode parsed from the prompt)
#   ctrl-w : toggle preview wrap
#   ctrl-o : copy the highlighted target's "<session>:<window-name>" to the
#            clipboard (pbcopy) — fully qualified so it stays valid to paste into
#            maw / tmux -t even after window indices shift.
#            Bound to ⌘O via Ghostty (keybind = cmd+o=text:\x0f → sends Ctrl-O).
#            Resolves both fields from {1} (active pane id), so it works in both views.
#   j/k    : move down/up. Under the Thai (Kedmanee) input source these physical
#            keys send ่ (mai ek) / า (sara aa) instead of ASCII j/k, so both chars
#            are also bound to down/up (and unbound/rebound alongside j,k on the
#            ctrl-s search toggle). Arrow keys and Ctrl-j/Ctrl-k work regardless of
#            layout (fzf defaults, not remapped by any keyboard layout) — the
#            fallback if a bind ever mismatches a layout. See ~/.config/wezterm/keys.lua
#            phys:J comment for the same Thai-layout-eats-the-key root cause.
#   p      : cycle preview size, half (default, right 60% of width — leaves the
#            list usable) <-> full (right 99%, fzf's own size cap — for
#            inspecting a pane closely; at 99% the list itself is nearly invisible).
#            Same Thai-layout problem as j/k: physical p sends
#            ย (yo yak) under Kedmanee, so both chars are bound (and both
#            unbound/rebound alongside j,k on the ctrl-s search toggle below).
#   q      : quit, same as esc. Physical q sends ๆ (mai yamok) under Kedmanee, so
#            both chars are bound (and both unbound/rebound with the rest on
#            ctrl-s, so "q"/"ๆ" can still be typed into a search query).
# STARTUP CURSOR: session view (the default view at launch) opens with the
# cursor already on the CURRENT session's row, not row 1 — found by matching
# the session name against field-2 of each row, then placed via --sync +
# start:pos(N) (--sync so the start event sees the fully-loaded list; fzf
# consumes its input stream asynchronously otherwise). Falls back to row 1 if
# the current session can't be resolved or isn't in the list.
set -euo pipefail

[ -n "${TMUX:-}" ] || { echo "tmux-switch: run inside tmux" >&2; exit 1; }

# absolute path to self — fzf reload/transform bindings re-invoke us as
# `tmux-switch __rows <mode>` to regenerate the list for the new view.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# emit_rows <mode> [session_filter] -> final fzf input: "<pane_id>\t<display>".
# session mode: rows sorted by session id (numeric). win mode: rows sorted by window
# index (numeric); session_filter (if set) restricts rows to that session.
emit_rows() {
  local mode="$1" filt="${2:-}" pin="${3:-}" now active_widx
  now=$(date +%s)
  # win mode places the target session's ACTIVE window at row `pin+1` (0-based
  # pin, see the TAB CURSOR comment near the bind for why this exists instead
  # of a pos() bind: a plain `reload()` on Tab preserves the SAME 0-based row
  # index the cursor was already sitting on in session view — not row 1 — so
  # the fix is to put the right window at that exact index, via {n}. pin is
  # OPTIONAL and empty means "don't reorder, plain window-index order" — only
  # the Tab-drill reload passes one; ctrl-x's kill-and-refresh reload must NOT
  # default to pin=0, or killing a window would re-sort the survivors under
  # the cursor instead of leaving them in the order you expect to keep killing.
  active_widx=""
  if [ "$mode" = win ] && [ -n "$filt" ] && [ -n "$pin" ]; then
    active_widx=$(tmux display-message -p -t "$filt" '#{window_index}' 2>/dev/null) || active_widx=""
  fi
  case "$pin" in *[!0-9]*) pin= ;; esac
  # sticky column-header row (--header-lines=1). Empty field-1 so --with-nth='2..'
  # strips it just like the data rows, keeping the labels column-aligned.
  # column widths: SESSION/WHERE given generous, deliberate breathing room —
  # not sized to today's longest name (24 chars, "bestfitt-kitchen-flutter");
  # the popup has ~240 cols of measured slack, so these just spend some of it
  # rather than pinch-fitting. WHERE (win view) is <session>:<window_index>,
  # a few chars longer than the bare session name, so it gets its own wider
  # column — keep in sync with the two data printfs in the awk END block
  # below (4 occurrences total, header+data per view).
  case "$mode" in
    session) printf '\t%-36s %-12s %-8s %-5s %-5s %s\n' SESSION ATTACHED APP AGE WIN FLAG ;;
    *)       printf '\t%-40s %-18s %-8s %-5s %s\n'       WHERE WINDOW-NAME APP AGE FLAG ;;
  esac
  tmux list-panes -a -F \
    '#{pane_id}	#{session_name}	#{window_index}	#{pane_current_command}	#{window_activity}	#{pane_title}	#{host}	#{pane_active}	#{window_active}	#{window_name}	#{session_attached}	#{@cc_wait}	#{@cc_done}	#{session_id}	#{@cc_processing}' \
  | awk -F'\t' -v now="$now" -v mode="$mode" -v filt="$filt" -v active="$active_widx" -v pin="$pin" '
      function age(t,  d){ if(t==""||t+0==0)return "-"; d=now-t; if(d<0)d=0;
        return d<60? d"s" : (d<3600? int(d/60)"m" : (d<86400? int(d/3600)"h" : int(d/86400)"d")) }
      {
        # win view is always scoped to one session: skip panes from other sessions.
        if (mode=="win" && filt!="" && $2!=filt) next
        pid=$1; sess=$2; widx=$3; app=$4; wact=$5; title=$6; host=$7
        pa=$8; wa=$9; wname=$10; satt=$11; cw=$12; cd=$13; sid=$14; cp=$15; sub(/\$/,"",sid)
        if (app ~ /^[0-9]+\.[0-9]+/) app="claude"
        if (title==host || title=="") title="-"
        # @cc_wait/@cc_done are window options carrying " ❓"/" 🤖" (leading space);
        # treat any non-blank value as "set".
        waitf=(cw ~ /[^[:space:]]/)?1:0; donef=(cd ~ /[^[:space:]]/)?1:0
        procf=(cp ~ /[^[:space:]]/)?1:0

        if (mode=="session") {
          k=sess
          if (!(k in sorder)) { sorder[k]=++sn; sseq[sn]=k }
          wk=sess SUBSEP widx
          if (!(wk in swseen)) { swseen[wk]=1; swin[k]++ }
          if (wact+0 > sact[k]+0) sact[k]=wact
          satt_[k]=satt; ssid[k]=sid
          if (waitf) swait[k]=1; if (procf) sproc[k]=1; if (donef) sdone[k]=1
          # representative pane for this session row (drives preview + Enter-jump):
          # precedence wait-window > done-window > current-window active pane (the old
          # default) > first pane seen — so a flag earned on window 2 does not jump you
          # to window 1 just because that is the session current window. cw/cd are
          # window options, so they already reflect the window of the current pane, not
          # the session as a whole. Ties (e.g. two panes in the same flagged window)
          # prefer the active pane of that window (pa==1), matching win view wpid logic.
          lvl=waitf?3:(donef?2:((wa==1&&pa==1)?1:0))
          if (!(k in spid) || lvl>spid_lvl[k] || (lvl==spid_lvl[k] && pa==1)) { spid[k]=pid; sapp[k]=app; spid_lvl[k]=lvl }
        }
        else { # win
          k=sess SUBSEP widx
          if (!(k in worder)) { worder[k]=++wn; wseq[wn]=k }
          wact_[k]=wact; wsess[k]=sess; wwidx[k]=widx
          if (waitf) wwait[k]=1; if (procf) wproc[k]=1; if (donef) wdone[k]=1
          if (pa==1 || !(k in wpid)) { wpid[k]=pid; wapp[k]=app
            wnm[k]=(wname!=""?wname:title) }
        }
      }
      END {
        if (mode=="session") {
          for (i=1;i<=sn;i++){ k=sseq[i]
            # session view sorts by session id (numeric, ascending) — see the ssid[k]
            # sort-key in the printf below. The ❓/🤖 flag is still shown in the FLAG
            # column but no longer floats the row to the top (pri kept only for win view).
            atn=swait[k]?0:(sdone[k]?1:2); pri=atn*2+((sapp[k]=="claude")?0:1)
            mark=swait[k]?"❓":(sproc[k]?"⏳":(sdone[k]?"🤖":"-"))
            # BSD awk pads %-Ns by BYTES; "● attached" is 12 bytes but 10 columns
            # wide, so pad the ATTACHED field to 12 *visual* cols by hand.
            if (satt_[k]+0>0) { att="● attached"; aw=10 } else { att="-"; aw=1 }
            printf "%d\t%s\t%-36s %s%*s %-8s %-5s %-5s %s\n", \
              ssid[k], spid[k], k, att, 12-aw, "", sapp[k], age(sact[k]), (swin[k]"win"), mark }
        } else {
          # win view sorts by window index (numeric, ascending). When pin is
          # non-empty (only the Tab-drill reload passes one — see emit_rows),
          # the active window of this session is instead pulled out and
          # reinserted at rank `pin` (0-based) so it lands at the exact row
          # the cursor already occupied before Tab; every other window keeps
          # its relative order, shifted to make room.
          has_pin=(pin!="")
          if (has_pin) { p=pin+0; if (p<0) p=0; if (p>wn-1) p=wn-1 }
          rank=-1
          for (i=1;i<=wn;i++){ k=wseq[i]
            # The wwait/wproc/wdone flag is still shown in the FLAG column but
            # no longer floats the row to the top.
            mark=wwait[k]?"❓":(wproc[k]?"⏳":(wdone[k]?"🤖":"-"))
            if (!has_pin) { finalrank=wwidx[k]+0 }
            else if (active!="" && wwidx[k]==active) { finalrank=p }
            else { rank++; finalrank=(rank<p)?rank:rank+1 }
            printf "%d\t%s\t%-40s %-18s %-8s %-5s %s\n", \
              finalrank, wpid[k], wsess[k]":"wwidx[k], wnm[k], wapp[k], age(wact_[k]), mark }
        }
      }' \
  | sort -s -t'	' -k1,1n | cut -f2-
}

# fzf reload/transform callback: print rows for a given view spec and exit.
# spec is "session" or "win:<session>" (the bracket text parsed out of the
# prompt); optional 3rd arg is the 0-based row to pin the active window at
# (see the TAB CURSOR comment near the bind — comes from fzf's {n}). Omitted
# (as ctrl-x's reload omits it) means plain window-index order, no reorder.
if [ "${1:-}" = "__rows" ]; then
  spec="${2:-session}"
  pin="${3:-}"
  case "$spec" in
    win:*) emit_rows win "${spec#win:}" "$pin" ;;
    *)     emit_rows "$spec" ;;
  esac
  exit 0
fi

command -v fzf >/dev/null 2>&1 || { echo "tmux-switch: needs fzf (brew install fzf)" >&2; exit 1; }

# Disable software flow control on THIS popup's pty so Ctrl-s (0x13 = XOFF) reaches fzf
# as a bindable key instead of freezing terminal output. fzf sets raw mode itself, but a
# transform's child shell restores cooked mode (re-enabling IXON) — so the *second* Ctrl-s
# would otherwise hit a flow-control-armed tty and hang. display-popup -E gives us an
# isolated pty, so this never leaks to the parent terminal. Best-effort; never fatal.
# MUST stay below the __rows early-exit: reload/transform re-invoke us as `__rows <mode>`,
# and running this stty (reading /dev/tty) in that child stalls against fzf's tty → the
# reload never returns rows (Tab appears dead). Only the interactive launch needs it.
stty -ixon </dev/tty >/dev/null 2>&1 || true

rows=$(emit_rows session)
[ -n "$rows" ] || { echo "no live windows"; exit 0; }

# 1-based index (over DATA rows only — --header-lines=1 already strips the
# header from fzf's list) of the current session's row, for the startup cursor
# below. Session name is the first whitespace token of field 2 (the
# padded name — see emit_rows' column-width comment above). Never derive
# "current" from $TMUX — stale after popup creation; ask tmux fresh. Falls
# back to 1 (top) if unresolved or not found.
start_pos=1
if cur_sess=$(tmux display-message -p '#{session_name}' 2>/dev/null) && [ -n "$cur_sess" ]; then
  idx=$(printf '%s\n' "$rows" | tail -n +2 | cut -f2 | awk -v s="$cur_sess" '{split($0,a," ")} a[1]==s{print NR; exit}') || true
  start_pos=${idx:-1}
fi

        # --preview='tmux capture-pane -ep -t {1} | sed "/^[[:space:]]*$/d" | tail -n "${FZF_PREVIEW_LINES:-10}"' \
        # --preview-window='up,99%,nowrap' \
# field 1 (active pane id) is the action target, hidden from view; field 2.. shown.
# preview is the highlighted target's active-pane live screen.

prefix_session='view: [session]'
prefix_window='view: [window]'
header=$' · Tab drill into session \nj/k move · Ctrl-s search · ⌘O copy \nCtrl-x kill session · Enter switch · q/esc quit'
# TAB CURSOR: entering window view lands on the drilled session's active
# window. Tried a pos() bind first (mirroring STARTUP CURSOR's start:pos(N)
# trick) but fzf 0.67 silently drops a chained pos() whenever the same
# transform result also contains change-prompt(...)/change-header(...) —
# verified in isolation: reload-sync(...)+pos(N) alone lands correctly every
# time, add either change- action anywhere in the string (before OR after
# pos()) and it always clamps back to some OTHER row, deterministically,
# regardless of N. What that "other row" turned out to be: a plain (async)
# reload() PRESERVES the 0-based row index the cursor already occupied before
# Tab, it doesn't reset to row 1 (confirmed by testing from a session that
# ISN'T row 1 of the session list — the drilled window list landed on ITS row
# 2, not row 1). fzf exposes that exact index as the {n} placeholder, so
# instead of fighting fzf's pos(), emit_rows is told (via __rows's 3rd arg)
# to put the active window at THAT row — {n} is substituted into the bind
# string at tab-press time, same mechanism as the existing {1}.
sel=$(printf '%s\n' "$rows" | FZF_DEFAULT_OPTS='' fzf --layout=reverse --no-sort --no-input --sync \
        --delimiter=$'\t' --with-nth='2..' --header-lines=1 \
        --prompt='switch [session] ❯ ' \
        --header="$prefix_session$header" \
        --bind="start:pos($start_pos)" \
        --preview='tmux capture-pane -ep -t {1} | sed "/^[[:space:]]*$/d" | tail -n "${FZF_PREVIEW_LINES:-40}"' \
        --preview-window='up,65%,nowrap' \
        --list-border \
        --color='preview-border:blue' \
        --bind='ctrl-w:toggle-preview-wrap' \
        --bind='j:down' --bind='k:up' \
        --bind='่:down' --bind='า:up' \
        --bind='q:abort' --bind='ๆ:abort' \
        --bind="ctrl-s:transform:if [ \"\$FZF_INPUT_STATE\" = enabled ]; then echo 'rebind(j,k,่,า,p,ย,q,ๆ)+hide-input'; else echo 'show-input+unbind(j,k,่,า,p,ย,q,ๆ)+pos(1)'; fi" \
        --bind='ctrl-o:execute-silent(name=$(tmux display-message -p -t {1} "#{session_name}:#{window_name}"); printf %s "$name" | pbcopy; tmux display-message "copied: $name")' \
        --bind="tab:transform:cur=\$(printf '%s' \"\$FZF_PROMPT\" | sed -n 's/.*\\[\\(.*\\)\\].*/\\1/p'); if [ \"\$cur\" = session ]; then s=\$(tmux display-message -p -t {1} '#{session_name}'); n={n}; printf 'change-prompt(switch [win:%s] ❯ )+change-header($prefix_window$header)+reload($SELF __rows win:%s %s)' \"\$s\" \"\$s\" \"\$n\"; else printf 'change-prompt(switch [session] ❯ )+change-header($prefix_session$header)+reload($SELF __rows session)'; fi" \
        --bind="ctrl-x:execute-silent(cur=\$(printf '%s' \"\$FZF_PROMPT\" | sed -n 's/.*\\[\\(.*\\)\\].*/\\1/p'); if [ \"\$cur\" = session ]; then tmux kill-session -t {1}; else tmux kill-window -t {1}; fi)+reload:cur=\$(printf '%s' \"\$FZF_PROMPT\" | sed -n 's/.*\\[\\(.*\\)\\].*/\\1/p'); $SELF __rows \${cur:-session}") || exit 0
[ -n "$sel" ] || exit 0

pane=$(printf '%s' "$sel" | cut -f1)
[ -n "$pane" ] || exit 0

# select the window/pane first, then attach the client to its session — so the
# client lands on exactly the chosen target. Works from inside display-popup (-E).
sess=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || exit 0
[ -n "$sess" ] || exit 0
tmux select-window -t "$pane" 2>/dev/null || true
tmux select-pane   -t "$pane" 2>/dev/null || true
tmux switch-client -t "$sess" 2>/dev/null || true
